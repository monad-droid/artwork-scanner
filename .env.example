# OpenSea API key — get one at https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=your_opensea_api_key

# Telegram Bot token — create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram Chat ID — send a message to your bot, then visit
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates to find your chat ID
TELEGRAM_CHAT_ID=your_chat_id

# NFT to monitor
NFT_CHAIN=ethereum
NFT_CONTRACT_ADDRESS=0xa7d8d9ef8d8ce8992df33d8b8cf4aebabd5bd270
NFT_TOKEN_ID=163000007

# Optional: collection slug (auto-resolved from contract if omitted)
# NFT_COLLECTION_SLUG=

# How often to check for new bids (in seconds)
POLL_INTERVAL_SECONDS=60

# Your current bid in ETH/WETH (used as the starting threshold)
CURRENT_BID_ETH=2
